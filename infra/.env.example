# 基础设施配置（复制为 .env 使用；infra/scripts/up.sh 会自动加载）

# --- RustFS（对象存储，所有服务的 blob/产物）---
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
# asset-management 默认 bucket: asset-assets；data-factory 默认 bucket: dfac-datasets

# --- Ray 独立集群（infra/scripts/ray-start.sh 启动后导出）---
# RAY_ADDRESS=127.0.0.1:6379
# RAY_ADDRESS=ray://127.0.0.1:10001

# --- 可观测性 ---
GRAFANA_ADMIN_PASSWORD=admin
