# llava-instruct 服务端配置（复制为 .env 使用；scripts/serve.sh 会自动加载）

# --- 存储后端 ---
# rustfs：写入 RustFS/S3 兼容对象存储（docker compose up -d 起容器后可直接用默认值）
# local ：写入本地内容寻址目录 data/blobs/（离线开发）
LLAVA_STORAGE_BACKEND=rustfs
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=llava-assets

# --- 数据目录（SQLite 元数据 / HF 缓存 / 临时区）---
# LLAVA_DATA_DIR=data

# --- Ray 集群（可选）---
# LLAVA_RAY_NUM_CPUS=8
# LLAVA_RAY_ADDRESS=ray://head:10001
# LLAVA_RAY_METRICS_PORT=8080
